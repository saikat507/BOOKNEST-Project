@startuml
title Figure 3.1: Use Case Diagram - BookNest

scale max 1600*1050
left to right direction
skinparam shadowing false
skinparam dpi 150
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam titleFontSize 18
skinparam titleFontStyle plain
skinparam actor {
  BackgroundColor #F8F8F8
  BorderColor #444444
  FontSize 10
}
skinparam usecase {
  BackgroundColor #DDF2DF
  BorderColor #579662
  FontSize 9
}
skinparam rectangle {
  BackgroundColor #F7FFF7
  BorderColor #579662
}
skinparam ArrowColor #555555
skinparam ArrowFontColor #111111
skinparam ArrowFontSize 8

actor Visitor
actor "Registered User" as User
actor "Book Owner" as Owner
actor Admin

User <|-- Owner

rectangle "BookNest Platform" {
  usecase "Register account" as UC_Register
  usecase "Login / logout" as UC_Login
  usecase "Reset password with OTP" as UC_Reset
  usecase "Browse and search books" as UC_Browse
  usecase "View book details" as UC_Detail
  usecase "List a book" as UC_List
  usecase "Edit or delete own book" as UC_EditBook
  usecase "Request book\nDonate, Exchange, Adopt, Buy" as UC_Request
  usecase "Offer own book for exchange" as UC_Offer
  usecase "Approve / reject request" as UC_Approve
  usecase "Complete transaction" as UC_Complete
  usecase "Manage borrowed returns" as UC_Return
  usecase "View wallet and coin ledger" as UC_Wallet
  usecase "Receive notifications" as UC_Notify
  usecase "Submit review" as UC_Review
  usecase "Report user or transaction" as UC_Report
  usecase "Upload ID for verification" as UC_VerifyUpload
  usecase "Manage profile" as UC_Profile
  usecase "Manage wishlist" as UC_Wishlist

  usecase "View admin dashboard" as UC_AdminDashboard
  usecase "Moderate users" as UC_Users
  usecase "Approve / reject verifications" as UC_Verifications
  usecase "Moderate books" as UC_Books
  usecase "View requests and transactions" as UC_Transactions
  usecase "Adjust coins" as UC_Coins
  usecase "Resolve reports" as UC_ResolveReports
  usecase "Update system settings" as UC_Settings
}

Visitor --> UC_Register
Visitor --> UC_Login
Visitor --> UC_Reset
Visitor --> UC_Browse
Visitor --> UC_Detail

User --> UC_Browse
User --> UC_Detail
User --> UC_List
User --> UC_EditBook
User --> UC_Request
User --> UC_Complete
User --> UC_Return
User --> UC_Wallet
User --> UC_Notify
User --> UC_Review
User --> UC_Report
User --> UC_VerifyUpload
User --> UC_Profile
User --> UC_Wishlist

Owner --> UC_Approve

Admin --> UC_AdminDashboard
Admin --> UC_Users
Admin --> UC_Verifications
Admin --> UC_Books
Admin --> UC_Transactions
Admin --> UC_Coins
Admin --> UC_ResolveReports
Admin --> UC_Settings

UC_Request ..> UC_Offer : <<include>>\nfor exchange
UC_Request ..> UC_VerifyUpload : <<extend>>\nfor adoption ID
UC_Approve ..> UC_Notify : <<include>>
UC_Complete ..> UC_Wallet : <<include>>
UC_Complete ..> UC_Notify : <<include>>
UC_Verifications ..> UC_Notify : <<include>>
UC_Coins ..> UC_Wallet : <<include>>

@enduml
